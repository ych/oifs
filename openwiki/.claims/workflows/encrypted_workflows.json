    {
      "id": "claim_6aeaafc37c3a40aba2035e10fee50bc7",
      "statement": "When opening an encrypted image, the system requires a password and obtains it in this order: `--password` flag, `OIFS_PASSWORD` environment variable, interactive prompt (except in `--json` mode where interactive is disabled).",
      "evidence": [
