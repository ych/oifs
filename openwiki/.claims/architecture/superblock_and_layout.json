    {
      "id": "claim_c157e9d1e26d422985332ce922906b22",
      "statement": "Two encryption schemes are supported: version 1 (ENCRYPTION_SCHEME_LEGACY) uses XChaCha20-Poly1305 without associated data; version 2 (ENCRYPTION_SCHEME_CONTEXT_BOUND) adds AAD binding ciphertext to file/chunk/filename context (domain separator OIFS-AAD-v1, kind byte, inode ID, chunk index, flags). Validation rejects unknown versions and requires encryption_version=0 when encrypted=false.",
