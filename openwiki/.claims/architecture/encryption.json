    {
      "id": "claim_99a9e2d7bf484fa6a56166333cd93d60",
      "statement": "Two encryption scheme versions exist: legacy (ENCRYPTION_SCHEME_LEGACY=1) uses empty associated data; context-bound (ENCRYPTION_SCHEME_CONTEXT_BOUND=2) uses structured AAD binding file inode_id (20 bytes), seekable chunk inode_id+chunk_idx+flags (29 bytes), or filename parent_inode (20 bytes) with domain separator 'OIFS-AAD-v1'. Stack-allocated helpers (file_aad_for_scheme_stack, chunk_aad_for_scheme_stack) avoid heap allocations on the hot path.",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L1528-L1535",
