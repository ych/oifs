    {
      "id": "claim_a10872e71c6344bc8c3a55ccf709e887",
      "statement": "DiskManager::defragment_inplace_on performs WAL-atomic in-place defragmentation using round-based copy-on-write: each round selects relocatable units with free targets, copies payload blocks to free space, stages metadata updates (inode pointers, bitmap alloc/free, indirect block pointers, ChunkEntry rewrites) into a single bounded WAL transaction, commits, applies via apply_journal_ops, advances an in-memory allocation bitmap mirror, syncs metadata per DurabilityMode, and checkpoints the WAL ring before the next round.",
      "evidence": [
