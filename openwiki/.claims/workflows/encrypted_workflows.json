    {
      "id": "claim_15f2680777804ef6950f43a292cf6acf",
      "statement": "File data in an encrypted OIFS is encrypted and decrypted on-the-fly using XChaCha20-Poly1305 with a unique 192-bit (24-byte) nonce per file or seekable chunk, generated via OsRng. The context-bound scheme (encryption_version=2) binds ciphertext to its context via structured AAD containing inode_id (file) or inode_id, chunk_idx, and flags (chunk), preventing reordering, rollback, or cross-file injection. Legacy scheme (encryption_version=1) uses empty AAD and remains readable.",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L1101-L1115",
          "version": "repo-lines-v1:sha256:1b938d26f51807bb0aa3af976e8699329c4436b8b47c48008b8a4192127d3ff7:"
        },
        {
