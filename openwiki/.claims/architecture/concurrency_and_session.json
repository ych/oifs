    {
      "id": "claim_238582ca4f3e470087df67b65c239353",
      "statement": "BoundedInodeCache and ShardedDirCache use 32 shards with Fibonacci hashing (constant 0x517cc1b727220a95) to uniformly distribute inode IDs and directory inode IDs across independent RwLock shards, eliminating lock contention between concurrent operations on different inodes/directories. Consecutive inode IDs never map to the same shard.",
      "evidence": [
        {
          "resource": "repo://src/disk/caches.rs#L201-L260",
          "version": "repo-lines-v1:sha256:3cba2f94b528e17e51a0a452bb3b1a99b85bdea30ee5309a544f7c7a457d99ad:"
