    {
      "id": "claim_c76e2d9fbc3d4187a50a9ffb6f7e7836",
      "statement": "During crash recovery, the journal replays transactions from tail to head, stopping at the first frame that fails validation (magic, length, CRC, or commit marker), and then resets the ring and marks the image cleanly unmounted.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L1031-L1086",
          "version": "repo-lines-v1:sha256:4e5311745ca42b81cd33d4a4b41dbd8dee1f0ac9f62d732d57b90b83961c574c:"
        }
      ]
