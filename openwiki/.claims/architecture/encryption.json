    {
      "id": "claim_8a9ee41a18ab44e9b7b38aa0daa605ea",
      "statement": "Short-message scalar fast path (≤192 bytes) implements exact RFC 8439 XChaCha20-Poly1305 with hchacha20 subkey derivation and per-block keystream generation, computing only the needed 64-byte ChaCha20 blocks. This avoids the NEON implementation's 256-byte block granularity waste on short filenames and small chunks while remaining byte-for-byte identical to the NEON path for larger payloads. All intermediate key material is zeroized after use.",
      "evidence": [
        {
          "resource": "repo://src/encryption.rs#L507-L644",
          "version": "repo-lines-v1:sha256:857a6fa8d963b58bf3806dc37b9e95389d142fdbfedb2b232297663bc243a3aa:"
        }
      ]
    },
    {
      "id": "claim_f2a207f065024ae0bcbab7108c32996b",
      "statement": "Seekable 64 KiB chunks (INODE_FLAG_SEEKABLE_64K) are encrypted independently with per-chunk 24-byte nonces and AAD binding inode_id, chunk_idx, and chunk flags (FLAG_EMPTY=0, FLAG_COMPRESSED=1, FLAG_RAW=2). Chunk ciphertext layout is [nonce | ciphertext | tag] stored in the chunk's block run. Decryption verifies AAD before returning plaintext, preventing chunk reordering, rollback, or cross-file injection.",
