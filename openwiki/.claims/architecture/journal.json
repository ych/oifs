        },
        {
          "resource": "repo://src/journal.rs#L613-L619",
          "version": "repo-lines-v1:sha256:c617c1e549cb6e7fea00449d880c360e34f5b9fb17bf07ae5f943f6ee32f185c:"
        }
      ]
    },
    {
      "id": "claim_0654079f25ef4459a0c4283dc9f877c8",
      "statement": "The CRC32C implementation is written in-crate with a compile-time generated table, ensuring verifiability under model checkers like Kani/CBMC.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L117-L158",
          "version": "repo-lines-v1:sha256:a4f9e6bc47a1270925999b6af0e8558b23620b199af4df56f33348d2fdad7e20:"
        }
      ]
    },
    {
      "id": "claim_222e34899f0848fe9b008558f3d9ee3a",
      "statement": "All metadata mutations (e.g., create_file, delete_file, mkdir, inode updates) must be journaled; bypassing the journal leads to stale transactions and potential silent data loss during recovery.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L26-L34",
