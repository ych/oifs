    {
      "id": "claim_1378058dec774af8bd8221bf3c62f0ef",
      "statement": "IPC authentication between client and master uses a challenge-response handshake where the password never travels over the wire. The client proves knowledge of the password by computing a BLAKE2b MAC with the ipc_auth_key (derived from password+salt via Argon2id), and the master proves it holds the same key by responding with its own MAC over the transcript. The master signals whether it expects a password (encrypted image) or session secret (unencrypted image), rejecting mismatched credentials. Mutual authentication prevents credential leakage to impostor masters.",
      "evidence": [
        {
          "resource": "repo://src/encryption.rs#L16-L26",
          "version": "repo-lines-v1:sha256:ef7732570feab5f2ca8e35c82e6ea7b7b283e75494766050128012b79a4277f5:"
        },
