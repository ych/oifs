# OpenWiki ignore rules for OIFS
# Excludes generated output, lockfiles, and auxiliary metadata while keeping every
# path referenced by existing OpenWiki evidence (`src/`, `include/`, `tests/`,
# `scripts/release_check.sh`, `.github/workflows/rust.yml`) valid.

# Generated GitHub Pages assets (keep `openwiki/` unignored so OpenWiki can snapshot existing pages during `--update`)
docs/openwiki-visualizer/
docs/index.html
docs/sitemap.xml
docs/robots.txt
docs/google*.html
docs/.nojekyll
plans/

# Build artifacts & dependency locks
target/
Cargo.lock

# Auxiliary docs, changelogs, and localized duplicates
CHANGELOG.md
README_zh.md
OPENWIKI_WORKFLOW.local.md
LICENSE

# Non-source CI/deployment workflows and tooling metadata
.github/scripts/
.github/workflows/openwiki-update.yml
.github/workflows/pages.yml
.github/workflows/release.yml
.agent/
.cargo/
.cross/
.pi/
.pi-lens.json
.mcp.json
Cross.toml
