        }
      ]
    },
    {
      "id": "claim_0c290bcbaf0945789e6e9388bfaca1e1",
      "statement": "For small filesystem images with fewer than 1028 blocks, SuperBlock dynamically scales down the inode table to preserve backward compatibility while guaranteeing at least one data block.",
      "evidence": [
        {
          "resource": "repo://src/superblock.rs#L256-L264",
          "version": "repo-lines-v1:sha256:0773433298e1910ac0cfbf989598ac7cfee4717191eb56e16aeda63c5c389218:"
