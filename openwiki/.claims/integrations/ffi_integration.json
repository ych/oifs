    {
      "id": "claim_4b06294ec09349808a9effc443baf78c",
      "statement": "Shared read sessions (oifs_begin_read/oifs_end_read) amortize RwLock acquisition and inode lookup; OIFSFileHandle from oifs_session_open_file/oifs_session_open_inode enables zero-RwLock positional reads via oifs_file_read_at and true zero-copy mmap slices via oifs_file_mmap_slice (returns 0 on success, 1 when unavailable, -1 on error).",
      "evidence": [
        {
          "resource": "repo://include/oifs.h#L135-L165",
