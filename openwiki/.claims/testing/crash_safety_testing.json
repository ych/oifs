        {
          "resource": "repo://src/disk.rs#L225-L228",
          "version": "repo-lines-v1:sha256:a1c7bdabc374cd8ca4c6aeec8f7ff0954b7cc011cb9d82c8eaa3e5df224cd958:"
        }
      ]
