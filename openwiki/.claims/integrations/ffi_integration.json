    {
      "id": "claim_46cfdd7462384d0397130b0cc22a1d2a",
      "statement": "The OIFS FFI provides a stable C ABI for filesystem lifecycle: oifs_open/oifs_open_with_password/oifs_open_with_options for creating/opening images (with optional encryption, storage mode, and journaling), oifs_open_read_only for shared read-only multi-process access, oifs_get_or_open/oifs_get_or_open_with_password for master-proxy handle reuse, oifs_close for destruction (without implicit flush), and oifs_flush for explicit durability.",
      "evidence": [
        {
          "resource": "repo://include/oifs.h#L85-L124",
          "version": "repo-lines-v1:sha256:8de317f1fdc00d29ecd951c1d3cb3a30f51b9d084e1b67d902d27d3a60d872d4:"
