    {
      "id": "claim_ed7136af4e1c4bc4be952f7818c4a588",
      "statement": "The write-ahead logging protocol requires: (1) staging metadata ops, (2) encoding a transaction frame, (3) appending to the ring and persisting header+frame, (4) applying the ops in place, (5) checkpointing to advance the tail after in-place writes are durable.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L1031-L1086",
          "version": "repo-lines-v1:sha256:4e5311745ca42b81cd33d4a4b41dbd8dee1f0ac9f62d732d57b90b83961c574c:"
