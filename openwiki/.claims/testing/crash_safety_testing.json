      ]
    },
    {
      "id": "claim_4a30039529ab4781a269eb8e7df3e2cc",
      "statement": "The Lazy durability mode (default) updates the shared mmap and OS page cache without per-mutation msync, surviving process crashes but requiring explicit flush or drop for power-loss safety.",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L128-L135",
          "version": "repo-lines-v1:sha256:413f18fc07a80c9076bec0aef38762867bc2d23ba62fa868fe66e2e0050c033e:"
