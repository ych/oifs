    {
      "id": "claim_55b88b533d744b699c732cb7ddd75549",
      "statement": "The FsckReport structure contains five fields: is_clean (bool), orphan_inodes (Vec<u64>), leaked_blocks (Vec<u64>), missing_blocks (Vec<u64>), and cross_linked_blocks (Vec<u64>).",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L163-L174",
          "version": "repo-lines-v1:sha256:ffd817362d35f6dfa1e3a10690e04a3ecb41db2259ecd457dd345e09687d962b:"
        }
      ]
    },
    {
      "id": "claim_969894437cb345b39f8c85cf180d3707",
      "statement": "Orphan inodes are allocated inodes not referenced by any directory entries (AllocatedInodes \\ ReferencedInodes), leaked blocks are data blocks marked allocated in bitmap but not mapped by any inode (AllocatedBlocks \\ ReferencedBlocks), missing blocks are data blocks mapped by inodes but marked free in bitmap (ReferencedBlocks \\ AllocatedBlocks), and cross-linked blocks are data blocks referenced by multiple inodes ({b | Count(References(b)) > 1}).",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L58-L63",
          "version": "repo-lines-v1:sha256:f31fe3afb748ca42eb810c616845c843aaf457db382e0902ad31dae1bb2e90d5:"
        }
      ]
    },
    {
      "id": "claim_774f38d2c1064dcba272d48face41252",
      "statement": "OIFS fsck is a diagnostic tool that reports inconsistencies without performing automatic repairs; users must stop using the filesystem, backup the image, determine corruption cause, and consider recreating the filesystem for safe recovery.",
