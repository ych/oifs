    {
      "id": "claim_b46814823e4544e69b7ff2012a6c6fb1",
      "statement": "The journaled mutation protocol follows five phases: (1) stage metadata ops using AllocSim to simulate allocations against copied bitmaps, (2) encode a transaction frame with coalescing and CRC32C, (3) append to the ring and persist header+frame with durability-mode-specific flush ordering, (4) apply ops in place via apply_op_in_place which performs absolute post-image writes, (5) checkpoint to advance the tail once in-place writes are durable.",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L2848-L2960",
          "version": "repo-lines-v1:sha256:42feca94d9852b68ade7b0ca62266beed61d424c25e953aa75a191d76122a37a:"
        },
        {
          "resource": "repo://src/journal.rs#L1360-L1480",
