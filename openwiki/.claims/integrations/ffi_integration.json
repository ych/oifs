    {
      "id": "claim_b0265000768b46df8714ddf0a0f62a56",
      "statement": "Asynchronous I/O uses OIFSAsyncFuture with inline fast-path (cache/mmap hits complete immediately on caller thread, oifs_async_poll returns 1), group commit for concurrent writes under DURABILITY_STRICT, and use-after-free safety via oifs_async_free drop barrier that waits for in-flight buffer writes. Callback APIs (oifs_read_at_async_cb, oifs_create_file_with_data_async_cb) are also provided.",
      "evidence": [
        {
          "resource": "repo://include/oifs.h#L175-L215",
