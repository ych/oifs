    },
    {
      "id": "claim_1563c570d09f49a28840d8c42b9ac7ae",
      "statement": "A transaction frame consists of: 4-byte magic (0x5741_4C54), 8-byte tx_seq, 4-byte payload_len, 4-byte CRC32C, the payload of serialized MetadataOps, and a 4-byte commit marker (0xDEAD_BEEF).",
      "evidence": [
