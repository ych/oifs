  "claims": [
    {
      "id": "claim_e4324002aa984914bc33c806f659a82d",
      "statement": "OIFS provides configurable durability modes (Lazy, RangeAsync, Strict, LegacyWholeMmapAsync) that control when and how modifications are synchronized to physical storage.",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L210-L235",
          "version": "repo-lines-v1:sha256:a9a7a22282b1c98afa9e114a9dc2774be14e442ee9332611dbf514d350190380:"
        }
      ]
    },
    {
      "id": "claim_4a30039529ab4781a269eb8e7df3e2cc",
      "statement": "The Lazy durability mode (default) updates the shared mmap and OS page cache without per-mutation msync, surviving process crashes but requiring explicit flush or drop for power-loss safety.",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L211-L218",
          "version": "repo-lines-v1:sha256:413f18fc07a80c9076bec0aef38762867bc2d23ba62fa868fe66e2e0050c033e:"
        }
      ]
    },
    {
      "id": "claim_71079787e4504fb7ae355ddeeacc1759",
      "statement": "The RangeAsync durability mode asynchronously flushes only modified byte ranges per mutation via msync(MS_ASYNC).",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L220-L223",
          "version": "repo-lines-v1:sha256:752be8ee5c6c70d4eaf050444258f40a5f599a391f286815e96d731f115d268c:"
        }
      ]
    },
    {
      "id": "claim_e681c9adbfc14ca49b81b74a56134a52",
      "statement": "The Strict durability mode synchronously flushes modified byte ranges via msync(MS_SYNC) on every mutation, guaranteeing physical storage persistence before returning.",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L225-L228",
          "version": "repo-lines-v1:sha256:ba56654b176bee071ecf56f4c3332d586079827e40414f6c23d1f8cc23c1e327:"
        }
      ]
    },
    {
      "id": "claim_3ca05a33d54048689b1a8b34d2cedadc",
      "statement": "The LegacyWholeMmapAsync durability mode asynchronously flushes the entire virtual memory map after every mutation.",
