  "claims": [
    {
      "id": "claim_f31fe6fec67747df8ae6f6d9389f60a3",
      "statement": "The journal subsystem implements a write-ahead log (WAL) for metadata mutations in OIFS, recording transactions before applying them in place to ensure crash resilience.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L1-L8",
          "version": "repo-lines-v1:sha256:23c36bef1274b73f07f2f115759f1c1358ec4fa319cd02168095a3422e48b714:"
        }
      ]
    },
    {
      "id": "claim_5569a21b88d24b78be8901841efa3923",
      "statement": "The journal region uses a fixed-size circular ring buffer (32 blocks) for storing transactions, located after the journal header block.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L85-L96",
          "version": "repo-lines-v1:sha256:dde9b6ba4c980b8a46ffe51108a6250068b48b8cbfd6b0a2ddd14f3a4c693e06:"
        }
      ]
    },
    {
      "id": "claim_3cd7bc41720c407c8fb261c4f3c997b5",
      "statement": "On crash recovery, the journal replays all durable-but-unapplied transactions from the ring buffer to restore a consistent state, eliminating the need for a full fsck.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L1-L8",
          "version": "repo-lines-v1:sha256:23c36bef1274b73f07f2f115759f1c1358ec4fa319cd02168095a3422e48b714:"
        },
        {
          "resource": "repo://src/journal.rs#L1031-L1086",
          "version": "repo-lines-v1:sha256:4e5311745ca42b81cd33d4a4b41dbd8dee1f0ac9f62d732d57b90b83961c574c:"
        }
      ]
    },
    {
      "id": "claim_dc23fe3bd74c4727afd46317c7d42ec8",
      "statement": "The SuperBlock layout is unchanged for backward compatibility; a journaled image is identified by geometry (inode_table_block >= 3 + JOURNAL_RESERVED_BLOCKS) and the journal header magic.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L10-L15",
          "version": "repo-lines-v1:sha256:0ce48c0a446c4782a74339741bd15f3d5d3032e0e0bc1031dda512c93a34ffd5:"
        }
      ]
    },
    {
      "id": "claim_3f52e0e1424f41c39a0144c6caffa304",
      "statement": "Every MetadataOp is an absolute post-image write or absolute bit-set operation, ensuring idempotent redo.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L227-L231",
          "version": "repo-lines-v1:sha256:30e1b075f59b97d60cab397c0950c065bbd86b28da444d58481dd79d77666d3b:"
        }
      ]
    },
    {
      "id": "claim_69ddd2c629154a808d8133f72630a54d",
      "statement": "Each transaction frame includes a CRC32C checksum (Castagnoli) over tx_seq, payload_len, and payload, plus a trailing commit marker (0xDEAD_BEEF) to detect torn writes.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L106-L110",
          "version": "repo-lines-v1:sha256:47408e28ae4713e6e970d2277120586f3deb7b58429b498042b737c480c8c00f:"
        },
        {
          "resource": "repo://src/journal.rs#L603-L608",
