    },
    {
      "id": "claim_bf8b048f03b741da9b6caa457cabe160",
      "statement": "The journal header block (block 3) contains a 40-byte state structure with magic, version, ring_blocks, head, tail, tx_seq, and cleanly_unmounted flag.",
      "evidence": [
        {
          "resource": "repo://src/journal.rs#L164-L221",
