    {
      "id": "claim_84fffe2787504b9fba5af6be29444920",
      "statement": "DecodedBlobCache (src/disk/caches.rs) is a bounded LRU cache for whole-file decoded payloads of non-seekable compressed/encrypted files: 4 entries max, 16 MiB per entry, 32 MiB total cap; keyed by (inode_id, size, compressed_size, first_block, nonce); used by read_at_with_inode to avoid O(calls × file_size) full-file decode cliffs.",
      "evidence": [
        {
          "resource": "repo://src/disk.rs#L5000-L5030",
