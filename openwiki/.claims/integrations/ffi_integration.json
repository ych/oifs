    {
      "id": "claim_9d41dd82c564466a89f9883e5cd1dfe6",
      "statement": "OIFS supports three durability modes controlled via oifs_set_durability_mode: LAZY (OS page cache, default), RANGE_ASYNC (batched dirty-range async flush), and STRICT (synchronous msync/barriers for group commit).",
