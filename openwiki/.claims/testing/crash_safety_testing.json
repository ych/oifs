    {
      "id": "claim_e4324002aa984914bc33c806f659a82d",
      "statement": "OIFS provides configurable durability modes (Lazy, RangeAsync, Strict, LegacyWholeMmapAsync) that control when and how modifications are synchronized to physical storage.",
