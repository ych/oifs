    {
      "id": "claim_03d8799defb64ba289629cb96c5a4da0",
      "statement": "SuperBlock::new_v3 is the primary layout constructor for v3 images (format_version=3). It computes bitmap spans in a single pass (no iterative fixed-point) to keep CBMC tractable: inode bitmap sized to inode_count, data bitmap sized to remaining data blocks, inode table capped at 1024 blocks (16,384 inodes at 256 bytes/record). Minimum 5 blocks for non-journaled; journaled requires 37+ blocks for the 33-block WAL region.",
      "evidence": [
        {
          "resource": "repo://src/superblock.rs#L152-L204",
